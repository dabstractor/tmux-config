# Layout 00 — YOUR config (restore point).
# Sources tubular.conf for its CONTENT (the {{token}} pills, caps, icons).
# Colors come from whichever theme is active — tubular.conf's own
# @tubular_theme/@tubular_pane_bg get overridden by the applier afterwards,
# so with the "tubular" theme selected this is exactly your daily setup.
source-file ~/.config/tmux/tubular.conf
